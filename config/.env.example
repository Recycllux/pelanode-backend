# Copy to config/.env and fill in. Never commit config/.env.
# Keys and defaults: P0-11 section 7.
SPRING_PROFILES_ACTIVE=local
PN_DB_URL=jdbc:h2:file:/data/pelanode
PN_DEMO_PACK_DIR=/app/data/demo/hack-001
PN_MEDIA_ROOT=/app/data/demo/hack-001/media
PN_EXPORT_DIR=/data/exports
PN_DEMO_MISSION_ID=HACK-001
PN_SIMULATED_MODE=true
PN_REPLAY_SPEED=demo
PN_REPLAY_AUTOSTART=false
PN_AI_MODE=precomputed
PN_AI_OUTPUTS_FILE=/app/data/demo/hack-001/inference/model_outputs.json
PN_CONTEXT_ADAPTER=simulated
PN_CONTEXT_DIR=/app/data/context
PN_ASSOC_LEVEL_KM=25
PN_ASSOC_LEVEL_HOURS=6
PN_ASSOC_TEMP_KM=50
PN_ASSOC_TEMP_HOURS=24
# Secret: required on every POST as header X-PN-Key
PN_WRITE_API_KEY=
PN_CORS_ORIGINS=http://localhost:5173
PN_LOG_LEVEL=INFO
