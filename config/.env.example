# Copy to config/.env and fill in what you need; everything is optional. Never commit config/.env.
# The app reads config/.env by itself (local run from IntelliJ or mvnw), and Docker takes it with
# --env-file. Relative paths are found from the working directory upwards. Keys: P0-11 section 7.

# Database. Default (nothing set): embedded H2 in .data/. For PostgreSQL, uncomment and fill:
# PN_DB_URL=jdbc:postgresql://localhost:5432/pelanode
# PN_DB_USER=postgres
# PN_DB_PASSWORD=

# Secret: required on every POST as header X-PN-Key. Empty = writes open (fine on your own machine).
PN_WRITE_API_KEY=

PN_DEMO_PACK_DIR=data/demo/hack-001
PN_MEDIA_ROOT=data/demo/hack-001/media
PN_DEMO_MISSION_ID=HACK-001
PN_SIMULATED_MODE=true
PN_REPLAY_SPEED=demo
PN_REPLAY_AUTOSTART=false
PN_AI_MODE=precomputed
# PN_AI_OUTPUTS_FILE=data/demo/hack-001/inference/model_outputs.json
PN_CONTEXT_ADAPTER=simulated
PN_ASSOC_LEVEL_KM=25
PN_ASSOC_LEVEL_HOURS=6
PN_ASSOC_TEMP_KM=50
PN_ASSOC_TEMP_HOURS=24
PN_CORS_ORIGINS=http://localhost:5173
PN_LOG_LEVEL=INFO
